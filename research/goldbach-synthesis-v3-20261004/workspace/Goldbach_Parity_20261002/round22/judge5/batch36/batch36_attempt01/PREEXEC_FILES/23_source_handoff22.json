  "mathematical_contract": {
    "point": "w=(a:Complex)-(theta:Complex)*Complex.I",
    "coefficient_identity": "kernelCoefficient(w) = (2/a^2)*(1+abs(theta)/sqrt(a^2+theta^2))",
    "coefficient_identity_domain": "a:Real, theta:Real, 0<a; theta unrestricted",
    "coefficient_bound": "kernelCoefficient(w) <= 4/a^2",
    "coefficient_bound_domain": "0<a; theta unrestricted",
    "decay_identity": "decayGap(w) = (Real.pi/2-Real.arctan(abs(theta)/a))/2",
    "decay_identity_domain": "0<a; theta unrestricted",
    "uniform_decay_lower_bound": "Real.arctan(a/Real.pi)/2 <= decayGap(w)",
    "uniform_decay_lower_bound_domain": "0<a and abs(theta)<=Real.pi",
    "positivity": "0<circleDecayFloor(a) for 0<a; branch/slitPlane and all algebraic denominator signs constructed from 0<a.",
    "continuity": "circleMellinRadius continuous jointly on Real*Real; circleDecayFloor continuous on Real; closed coefficient RHS continuousAt p when 0<p.1.",
    "constructed_charges": [
      "Actual re/im and nonzero/slitPlane",
      "Actual norm and principal Arg identities",
      "Sine and positive rotation-cosine square relation",
      "Actual rpow coefficient to rational identity",
      "Uniform coefficient bound from abs(theta)<=norm(w)",
      "Actual atan reciprocal identity and monotonicity for decay floor",
      "Joint continuity with nonzero denominators"
    ],
    "no_final_geometry_premises": true
  },
