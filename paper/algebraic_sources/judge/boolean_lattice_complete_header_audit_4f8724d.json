  "section_context_independently_read_and_closed": "{\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3]",
  "new_11_complete_closed_source_headers": {
    "toggle_involutive": "theorem toggle_involutive {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (i : \u03c3) : Function.Involutive (toggle i)",
    "up_eq_sum": "theorem up_eq_sum {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (f : Finset \u03c3 \u2192 \u211a) (s : Finset \u03c3) : up f s = \u2211 i : \u03c3, raiseAt i f s",
    "down_eq_sum": "theorem down_eq_sum {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (f : Finset \u03c3 \u2192 \u211a) (s : Finset \u03c3) : down f s = \u2211 i : \u03c3, lowerAt i f s",
    "raiseAt_sum": "theorem raiseAt_sum {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (i : \u03c3) (F : \u03c3 \u2192 Finset \u03c3 \u2192 \u211a) (s : Finset \u03c3) : raiseAt i (fun t => \u2211 j : \u03c3, F j t) s = \u2211 j : \u03c3, raiseAt i (F j) s",
    "lowerAt_sum": "theorem lowerAt_sum {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (i : \u03c3) (F : \u03c3 \u2192 Finset \u03c3 \u2192 \u211a) (s : Finset \u03c3) : lowerAt i (fun t => \u2211 j : \u03c3, F j t) s = \u2211 j : \u03c3, lowerAt i (F j) s",
    "coordinate_adjoint": "theorem coordinate_adjoint {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (i : \u03c3) (f h : Finset \u03c3 \u2192 \u211a) : (\u2211 s : Finset \u03c3, raiseAt i f s * h s) = \u2211 s : Finset \u03c3, f s * lowerAt i h s",
    "coordinate_commute": "theorem coordinate_commute {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (i j : \u03c3) (hij : i \u2260 j) (f : Finset \u03c3 \u2192 \u211a) (s : Finset \u03c3) : lowerAt i (raiseAt j f) s = raiseAt j (lowerAt i f) s",
    "coordinate_diagonal": "theorem coordinate_diagonal {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (i : \u03c3) (f : Finset \u03c3 \u2192 \u211a) (s : Finset \u03c3) : lowerAt i (raiseAt i f) s - raiseAt i (lowerAt i f) s = (if i \u2208 s then (-1 : \u211a) else 1) * f s",
    "adjoint": "theorem adjoint {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (f h : Finset \u03c3 \u2192 \u211a) : (\u2211 s : Finset \u03c3, up f s * h s) = \u2211 s : Finset \u03c3, f s * down h s",
    "commutator": "theorem commutator {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (f : Finset \u03c3 \u2192 \u211a) (s : Finset \u03c3) : down (up f) s - up (down f) s = ((Fintype.card \u03c3 : \u211a) - 2 * (s.card : \u211a)) * f s",
    "up_injective_below_middle": "theorem up_injective_below_middle {\u03c3 : Type*} [Fintype \u03c3] [DecidableEq \u03c3] (k : \u2115) (hk : 2 * k < Fintype.card \u03c3) (f : Finset \u03c3 \u2192 \u211a) (hlayer : \u2200 s : Finset \u03c3, s.card \u2260 k \u2192 f s = 0) (hup : \u2200 s : Finset \u03c3, up f s = 0) : f = 0"
  },
